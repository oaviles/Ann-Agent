# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
AGENT_NAME="Ann Agent"
AGENT_DESCRIPTION="An A2A-enabled enterprise assistant built with the Microsoft Agent Framework."
AGENT_VERSION="1.0.0"
AGENT_INSTRUCTIONS="You are Ann, a helpful enterprise assistant."
HOST="0.0.0.0"
PORT="8000"
LOG_LEVEL="INFO"

# Public HTTPS base URL of the deployed container app. Published in the agent card
# so remote agents (e.g. Copilot Studio) know where to send A2A requests.
PUBLIC_BASE_URL="http://localhost:8000"

# A2A endpoint configuration
A2A_PATH="/a2a/v1"
A2A_STREAMING="true"
A2A_V03_COMPAT="true"

# ---------------------------------------------------------------------------
# Model connection (Azure OpenAI / Azure AI Foundry)
# Leave AZURE_OPENAI_API_KEY empty to authenticate with Entra ID
# (managed identity in Azure, `az login` locally).
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Microsoft 365 Agent SDK / Microsoft Agent 365
# ---------------------------------------------------------------------------
AGENT365_ENABLED="false"
# Require a valid Entra ID bearer token on the A2A endpoint.
AGENT365_REQUIRE_AUTH="false"
# Entra application (client) id of the agent's app registration. Inbound tokens
# must carry this value as their audience.
AGENT365_CLIENT_ID=""
AGENT365_TENANT_ID=""
# Only needed for client-secret authentication; prefer managed identity in Azure.
AGENT365_CLIENT_SECRET=""
# Optional comma separated allow-list of calling application ids (appid/azp claim).
AGENT365_AUTHORIZED_CALLERS=""
# Optional comma separated list of accepted token issuers.
AGENT365_ISSUERS=""
AGENT365_VALIDATE_ISSUER="true"
